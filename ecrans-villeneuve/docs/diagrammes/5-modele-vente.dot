digraph G {rankdir=LR; graph [fontname="Arial",labelloc=t,label="Modèle du domaine — agrégats et événements"]; node [shape=record,fontname="Arial",style=filled,fillcolor="#EAF2F8"]; Seance [label="{Seance|id : SeanceId\\ldebut : LocalDateTime\\lplaces : Map<PlaceId, EtatPlace>\\lversion : long\\l|bloquer()\\lvendre()\\llibererBlocagesExpires()\\l}"]; Etat [label="{EtatPlace|statut : StatutPlace\\lcommande : CommandeId?\\lbloqueeJusqua : LocalDateTime?\\l}"]; Cmd [label="{Commande|id : CommandeId\\lseance : SeanceId\\lbillets : List<Billet>\\lexpireA : LocalDateTime\\lstatut : StatutCommande\\l|creer()\\ltotal()\\lpayer()\\lexpirer()\\l}"]; Billet [label="{Billet|place : PlaceId\\ltarif : Tarif\\l}"]; Tarif [label="{Tarif|categorie : Categorie\\lprix : Montant\\l}"]; Event [shape=box,label="EvenementVente\nCommandePayee\nCommandeExpiree\nVentePartenaireEnregistree"]; Seance->Etat [label="1..*"]; Cmd->Billet [label="1..10"]; Billet->Tarif; Cmd->Event [label="produit"]; }